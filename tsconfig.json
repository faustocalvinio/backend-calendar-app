{
   "compilerOptions": {
      "target": "ES2020",  // Generar código compatible con ES2020
      "module": "ESNext",  // Usar ESNext para módulos
      "moduleResolution": "node",  // Resolver módulos de manera compatible con Node
      "rootDir": "./src",  // Tu carpeta de código fuente
      "outDir": "./dist",  // Los archivos compilados van a dist
      "esModuleInterop": true,  // Habilitar interoperabilidad de módulos
      "strict": true,  // Habilitar todas las comprobaciones estrictas
      "skipLibCheck": true,  // Omite comprobación de bibliotecas
      "forceConsistentCasingInFileNames": true  // Asegura consistencia en los nombres de archivo
   },
   "include": ["src/**/*.ts"]  // Incluir todos los archivos .ts en src
}
